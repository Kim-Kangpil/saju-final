{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/payment/layout,_N_T_/payment/close/layout,_N_T_/payment/close/page,_N_T_/payment/close"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/payment/close/__PAGE__",
    "/payment/close",
    "/payment",
    "/_index",
    "/_head"
  ]
}